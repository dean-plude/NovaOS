; edutest.inf - the package of edutest.sys, the driver for QEMU's edu device
; (tools/drivertest/edutest.c; the edu self-test installs it with pnputil /add-driver /install)
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 10/12/2026,1.0.0.0
CatalogFile = edutest.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
edutest.sys = 1,,

[Manufacturer]
%ManufacturerName% = Edu,NTamd64

[Edu.NTamd64]
%DeviceDesc% = EduTest_Install, PCI\VEN_1234&DEV_11E8

[EduTest_Install.NT]
CopyFiles = EduTest_Files

[EduTest_Files]
edutest.sys

[EduTest_Install.NT.HW]
AddReg = EduTest_HwReg

[EduTest_HwReg]
HKR,,EduTestSetting,0x00010001,1

[EduTest_Install.NT.Services]
AddService = EduTest, 0x00000002, EduTest_Service

[EduTest_Service]
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1
ServiceBinary = %13%\edutest.sys

[Strings]
ProviderName     = "NovaOS Test"
ManufacturerName = "QEMU"
DiskName         = "NovaOS edu driver test"
DeviceDesc       = "QEMU edu device (NovaOS test driver)"
