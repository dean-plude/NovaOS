; kmdfedu.inf - the package of kmdfedu.sys, a KMDF driver for QEMU's edu device
; (tools/drivertest/kmdfedu.c; the kmdfedu self-test installs it with pnputil /add-driver /install).
; As a WDK KMDF driver's INF does, it names the framework version in its .Wdf section;
; the driver binds to Wdf01000.sys (in System32\drivers) through WdfLdr.sys when it loads.
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 10/13/2026,1.0.0.0
CatalogFile = kmdfedu.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
kmdfedu.sys = 1,,

[Manufacturer]
%ManufacturerName% = Edu,NTamd64

[Edu.NTamd64]
%DeviceDesc% = KmdfEdu_Install, PCI\VEN_1234&DEV_11E8

[KmdfEdu_Install.NT]
CopyFiles = KmdfEdu_Files

[KmdfEdu_Files]
kmdfedu.sys

[KmdfEdu_Install.NT.HW]
AddReg = KmdfEdu_HwReg

[KmdfEdu_HwReg]
HKR,,KmdfEduSetting,0x00010001,1

[KmdfEdu_Install.NT.Services]
AddService = KmdfEdu, 0x00000002, KmdfEdu_Service

[KmdfEdu_Service]
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1
ServiceBinary = %13%\kmdfedu.sys

[KmdfEdu_Install.NT.Wdf]
KmdfService = KmdfEdu, KmdfEdu_WdfSection

[KmdfEdu_WdfSection]
KmdfLibraryVersion = 1.33

[Strings]
ProviderName     = "NovaOS Test"
ManufacturerName = "QEMU"
DiskName         = "NovaOS KMDF edu driver test"
DeviceDesc       = "QEMU edu device (NovaOS KMDF test driver)"
