; wddmdod.inf - the package of wddmdod.sys, a WDDM display-only driver for
; QEMU's standard VGA (tools/drivertest/wddmdod.c; the wddm self-test
; installs it with pnputil /add-driver /install)
[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 10/13/2026,1.0.0.0
CatalogFile = wddmdod.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
wddmdod.sys = 1,,

[Manufacturer]
%ManufacturerName% = Qemu,NTamd64

[Qemu.NTamd64]
%DeviceDesc% = WddmDod_Install, PCI\VEN_1234&DEV_1111

[WddmDod_Install.NT]
CopyFiles = WddmDod_Files

[WddmDod_Files]
wddmdod.sys

[WddmDod_Install.NT.Services]
AddService = WddmDod, 0x00000002, WddmDod_Service

[WddmDod_Service]
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1
ServiceBinary = %13%\wddmdod.sys

[Strings]
ProviderName     = "NovaOS Test"
ManufacturerName = "QEMU"
DiskName         = "NovaOS WDDM display-only driver test"
DeviceDesc       = "QEMU standard VGA (NovaOS WDDM display-only test driver)"
