Define the verifier's state-separation option

The source reads and uses FxStateSeparationDetectionOption, the
StateSeparationDetection member, FxVerifierQueryStateSeparationDetection
and FxRegKey::VerifyStateSeparationRegistryPolicy, but the published files
leave their definitions blank.  NovaOS defines the option as the source
uses it; the registry-policy check has nothing to report on NovaOS.

diff --git a/src/framework/shared/inc/private/common/fxglobals.h b/src/framework/shared/inc/private/common/fxglobals.h
index 30c1fd6..ba03eaf 100644
--- a/src/framework/shared/inc/private/common/fxglobals.h
+++ b/src/framework/shared/inc/private/common/fxglobals.h
@@ -82,6 +82,18 @@ typedef enum FxTrackPowerOption : UCHAR {
     FxTrackPowerMaxValue
 } FxTrackPowerOption;
 
+//
+// NovaOS: the published source names this verifier option but Microsoft
+// left its definition out.  "State separation" checks that a driver
+// writes only the registry locations Windows' driver isolation allows;
+// the option is read from the driver's Parameters\Wdf key.
+//
+typedef enum FxStateSeparationDetectionOption : UCHAR {
+    FxStateSeparationDetectionNone = 0,
+    FxStateSeparationDetectionLog,
+    FxStateSeparationDetectionMaxValue
+} FxStateSeparationDetectionOption;
+
 typedef enum FxVerifierDownlevelOption {
     NotOkForDownLevel = 0,
     OkForDownLevel = 1,
@@ -190,6 +202,10 @@ struct FxDriverGlobalsDebugExtension {
     //
     FxTrackPowerOption TrackPower;
 
+    //
+    // NovaOS: verifier check of registry writes (see the enum above)
+    //
+    FxStateSeparationDetectionOption StateSeparationDetection;
 
 
 
