; wddmtest.inf - the package of wddmtest.sys, a WDDM render miniport whose
; GPU is software, for a root-enumerated device (hardware ID root\WddmTest),
; as Microsoft's Basic Render Driver sits on ROOT\BasicRender
; (tools/drivertest/wddmtest.c; the wddm self-test makes the device with
; "kmttest create" and installs it with pnputil /add-driver /install)
[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 10/18/2026,1.0.0.0
CatalogFile = wddmtest.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
wddmtest.sys = 1,,

[Manufacturer]
%ManufacturerName% = NovaTest,NTamd64

[NovaTest.NTamd64]
%DeviceDesc% = WddmTest_Install, root\WddmTest

[WddmTest_Install.NT]
CopyFiles = WddmTest_Files

[WddmTest_Files]
wddmtest.sys

[WddmTest_Install.NT.Services]
AddService = WddmTest, 0x00000002, WddmTest_Service

[WddmTest_Service]
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1
ServiceBinary = %13%\wddmtest.sys

[Strings]
ProviderName     = "NovaOS Test"
ManufacturerName = "NovaOS Test"
DiskName         = "NovaOS WDDM render miniport test"
DeviceDesc       = "NovaOS WDDM test render adapter"
