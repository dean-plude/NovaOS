+/* (NovaOS) vn_ring_submit_internal() wakes an idle ring at most once per
+ * VN_RING_IDLE_TIMEOUT_NS of the guest's clock.  If that clock runs slower
+ * than the renderer's (a guest whose timer was calibrated badly), a wake-up
+ * can be held back while the renderer's ring thread has just gone idle, and
+ * then nobody wakes it: the wait below would never end.  A wait that goes
+ * on for tens of milliseconds with the ring idle wakes it again (harmless
+ * when the ring is awake or the wake-up was only slow). */
+#define VN_RING_REWAKE_ITERS 32
+
+static void
+vn_ring_rewake(struct vn_ring *ring, uint32_t seqno)
+{
+   if (!(vn_ring_load_status(ring) & VK_RING_STATUS_IDLE_BIT_MESA))
+      return;
+
+   uint32_t notify_ring_data[8];
+   struct vn_cs_encoder local_enc = VN_CS_ENCODER_INITIALIZER_LOCAL(
+      notify_ring_data, sizeof(notify_ring_data));
+   vn_encode_vkNotifyRingMESA(&local_enc, 0, ring->id, seqno, 0);
+   vn_renderer_submit_simple(ring->instance->renderer, notify_ring_data,
+                             vn_cs_encoder_get_len(&local_enc));
+}
